# LearningAI local development environment.
# Copy to .env and fill only the providers you plan to use.

# OpenRouter powers normal chat plus the custom foreground/background voice
# broker. Keep shared server fallback disabled unless this is a trusted
# deployment where the owner accepts provider usage.
OPENROUTER_API_KEY=
ALLOW_SERVER_OPENROUTER_FALLBACK=false

# Deepgram powers streaming speech-to-text and Deepgram Aura text-to-speech.
DEEPGRAM_API_KEY=
ALLOW_SERVER_DEEPGRAM_FALLBACK=false

# Serper is used by legacy typed-chat web-search routes. The custom voice
# broker delegates web work to the background OpenRouter model instead.
SERPER_API_KEY=
ALLOW_SERVER_SERPER_FALLBACK=false

# Voice mode is now chosen at runtime in Settings (no rebuild needed):
# - deepgram-duplex (default): the two-model "interaction" mimic. A fast
#   foreground model keeps the conversation moving while a background model does
#   the heavy lifting. Runs inside this app's own dev/start server — no separate
#   host — and needs only a Deepgram key plus an LLM key (OpenAI or OpenRouter;
#   the broker auto-detects the provider from the key shape).
# - deepgram-agent: the single Deepgram Voice Agent path.
# - openai-realtime: test/comparison-only speech-to-speech over WebRTC.
# VITE_VOICE_BROKER_MODE below is only the legacy initial default for the
# runtime setting ("deepgram" -> deepgram-agent, anything else -> duplex).
VITE_VOICE_BROKER_MODE=deepgram

# Real OpenAI key. Used by the read-aloud gpt-4o-mini-tts route and, when the
# fallback flag is enabled, to mint OpenAI Realtime client secrets server-side
# for the test voice mode. Realtime is BYOK-first: the browser can send its own
# OpenAI key, so this server key is optional.
OPENAI_API_KEY=
ALLOW_SERVER_OPENAI_FALLBACK=false
# OpenAI Realtime model for the test/comparison voice mode (browser WebRTC).
VITE_OPENAI_REALTIME_MODEL=gpt-realtime

# Set to false on deployed hosts to ignore the client-supplied x-miso-tts-api-url
# header and use only MISO_TTS_API_URL below (blocks localhost port probing).
MISO_TTS_ALLOW_HEADER_URL=true

# Remote voice/signaling server. Leave VITE_VOICE_WS_URL empty to use the same
# host the app is served from. When the app host cannot serve WebSockets
# (e.g. Vercel), point this at the dedicated voice server, e.g.
# wss://voice.example.com — set it in the web app build environment.
VITE_VOICE_WS_URL=
# On the voice server itself, list the web app origins allowed to open
# cross-origin voice WebSockets (comma-separated full origins).
# e.g. VOICE_ALLOWED_ORIGINS=https://tutor-system-architecture.vercel.app
VOICE_ALLOWED_ORIGINS=
VOICE_FOREGROUND_MODEL=openai/gpt-4o-mini

# Background model id must be valid for the provider you call through
# OpenRouter. Do not use this as the Codex app runtime model id.
VOICE_BACKGROUND_MODEL=openai/gpt-5.5
GPT55_API_KEY=

VOICE_BROKER_STT_MODEL=nova-3
VOICE_BROKER_TTS_MODEL=aura-2-thalia-en
VITE_VOICE_BROKER_TTS_MODEL=aura-2-thalia-en
VOICE_BROKER_TTS_SAMPLE_RATE=48000
VOICE_BROKER_TTS_DEADLINE_MS=180

# Optional local Miso wrapper for experimental TTS. The server only accepts
# loopback hosts for this URL in the local voice broker.
MISO_TTS_API_URL=http://127.0.0.1:8080
MISO_TTS_TOKENIZER_MODEL=unsloth/Llama-3.2-1B

# Experimental fast-ack and browser speech fallbacks. Keep these false for
# ordinary Deepgram/OpenRouter testing.
VOICE_BROKER_FAST_ACK=false
VOICE_BROKER_FAST_ACK_TEXT=Okay.
VOICE_BROKER_FAST_ACK_FILE=
VITE_VOICE_BROKER_BROWSER_TTS=false
