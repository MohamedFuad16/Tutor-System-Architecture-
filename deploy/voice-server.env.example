# Environment for the Tutor voice/signaling server (copy to /opt/tutor-system/.env).
# This configures the interaction tutor + background worker on the SERVER so the
# browser only needs to open the WebSocket — no per-user keys required.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Web app origin(s) allowed to open cross-origin voice WebSockets
# (comma-separated, full origins, no trailing slash).
VOICE_ALLOWED_ORIGINS=https://tutor-system-architecture.vercel.app

# Server-side provider keys. The ALLOW_SERVER_*_FALLBACK flags let the broker
# use these when the browser doesn't send its own (BYOK still works too).
OPENROUTER_API_KEY=
ALLOW_SERVER_OPENROUTER_FALLBACK=true
DEEPGRAM_API_KEY=
ALLOW_SERVER_DEEPGRAM_FALLBACK=true

# Voice models. Foreground = the cheap, fast "interaction tutor"; background =
# the smarter worker it delegates heavy web/PDF/reasoning work to.
VOICE_FOREGROUND_MODEL=deepseek/deepseek-v4-flash
VOICE_BACKGROUND_MODEL=openai/gpt-5.5
VOICE_BROKER_STT_MODEL=nova-3
VOICE_BROKER_TTS_MODEL=aura-2-thalia-en
VOICE_BROKER_TTS_SAMPLE_RATE=48000
